{
	"vars": {
		"browser": "brave",
		"terminal": "git-bash",
		"editor": "nvim",
		"dirs": [
			{
				"alias": "fast",
				"dir": "D:/AK/CLI/fast"
			}
		]
	},
	"aliases": [
		{
			"alias": "edit",
			"description": "Opens the source code of this CLI and a terminal window.",
			"commands": [
				{
					"tool": "cd",
					"args": ["$dir:fast"]
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$editor",
					"args": ["src/main.c"]
				}
			]
		},
		{
			"alias": "edit-commands",
			"description": "Opens the alias and commands list that we are following.",
			"commands": [
				{
					"tool": "cd",
					"args": ["$dir:fast"]
				},
				{
					"tool": "$editor",
					"args": ["bin/commands.txt"]
				}
			]
		},
		{
			"alias": "lc",
			"description": "Opens leetcode problemset page.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://leetcode.com/problemset/"]
				}
			]
		},
		{
			"alias": "x",
			"description": "Opens Twitter (now known as X).",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://x.com/"]
				}
			]
		},
		{
			"alias": "mt",
			"description": "Opens MonkeyType shortcut on desktop.",
			"commands": [
				{
					"tool": "start",
					"args": ["", "C:/Users/Nishchay/Desktop/Monkeytype.lnk"]
				}
			]
		},
		{
			"alias": "typerush",
			"description": "Opens typerush",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://typerush.com/account.html?play=1"]
				}
			]
		},
		{
			"alias": "overleaf",
			"description": "Opens overleaf projects page.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://overleaf.com/project/"]
				}
			]
		},
		{
			"alias": "mail",
			"description": "Opens my work email.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://mail.google.com/mail/u/1/#inbox"]
				}
			]
		},
		{
			"alias": "mail-compose",
			"description": "Opens my work email with a compose message box opened.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://mail.google.com/mail/u/1/#inbox?compose=new"]
				}
			]
		},
		{
			"alias": "notes",
			"description": "Opens google keep.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://keep.google.com/u/0/"]
				}
			]
		},
		{
			"alias": "yt",
			"description": "Opens youtube.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://youtube.com/"]
				}
			]
		},
		{
			"alias": "ex",
			"description": "Opens Excalidraw.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://excalidraw.com/"]
				}
			]
		},
		{
			"alias": "shutdown",
			"description": "Shuts the computer down.",
			"commands": [
				{
					"tool": "shutdown",
					"args": ["/s", "/t", "0"]
				}
			]
		},
		{
			"alias": "edit-$editor",
			"description": "Opens the source of $editor configuration of the system.",
			"commands": [
				{
					"tool": "cd",
					"args": ["C:/Users/Nishchay/AppData/Local/$editor/"]
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$editor",
					"args": []
				}
			]
		},
		{
			"alias": "portfolio",
			"description": "Opens the source code of portfolio project.",
			"commands": [
				{
					"tool": "cd",
					"args": ["D:/AK/Full Stack/portfolio/"]
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$editor",
					"args": []
				}
			]
		},
		{
			"alias": "blog",
			"description": "Opens the source of blogs.",
			"commands": [
				{
					"tool": "cd",
					"args": ["D:/AK/Blogs/"]
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$editor",
					"args": []
				}
			]
		},
		{
			"alias": "question",
			"description": "Opens the Enginuity website's question of the day.",
			"commands": [
				{
					"tool": "$browser",
					"args": ["https://joinenginuity.com/question-of-day"]
				}
			]
		},
		{
			"alias": "raa",
			"description": "Opens the source code of raa.",
			"commands": [
				{
					"tool": "cd",
					"args": ["D:/AK/Full Stack/raa/"]
				},
				{
					"tool": "$terminal",
					"args": []
				},
				{
					"tool": "$editor",
					"args": []
				}
			]
		}
	]
}
